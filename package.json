{
  "name": "vrchat-cache-tool",
  "version": "1.1.1",
  "description": "Windows utility for configuring and testing the VRChat download cache",
  "private": true,
  "productName": "VRChat 缓存管理",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "start": "npm run package:portable && pwsh -NoProfile -Command \"Start-Process './release/portable/VRChatCacheTool-win-x64.exe'\"",
    "test": "dotnet run --project native/Tests/Tests.csproj --configuration Release",
    "package:win": "npm run build && pwsh -NoProfile -File scripts/build-webview2.ps1",
    "package:portable": "npm run package:win"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "vue": "3.5.46"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.3.0",
    "@vitejs/plugin-vue": "6.0.11",
    "vite": "8.3.8"
  }
}
