<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <AssemblyName>VRChatCacheTool.Host</AssemblyName>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4370.26" GeneratePathProperty="true" />
    <PackageReference Include="System.Text.Json" Version="10.0.9" />
    <InternalsVisibleTo Include="VRChatCacheTool.Tests" />
  </ItemGroup>
  <Target Name="CopyWindowsLoader" AfterTargets="Build">
    <Copy SourceFiles="$(PkgMicrosoft_Web_WebView2)\runtimes\win-x64\native\WebView2Loader.dll" DestinationFolder="$(OutDir)" />
  </Target>
</Project>
